# Generate a long random value before production.
SECRET_KEY=replace-with-a-long-random-secret

SITE_NAME=WhisperBox

ADMIN_USERNAME=admin

# Run: python generate_password_hash.py
# Then paste the generated hash below.
ADMIN_PASSWORD_HASH=

# Local development:
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true
SESSION_COOKIE_SECURE=false

# SQLite is used automatically when DATABASE_URL is omitted.
# Example:
# DATABASE_URL=sqlite:///messages.db
